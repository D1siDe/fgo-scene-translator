<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FGOPatcher.Maui.MainPage"
             BackgroundColor="#1E1E1E">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="20" RowSpacing="15">
        <Label Grid.Row="0" Text="FGO RU Patcher" TextColor="#FFFFFF" FontSize="26"
               FontAttributes="Bold" HorizontalOptions="Center" />

        <Label x:Name="StatusLabel" Grid.Row="1" Text="Проверьте сервер"
               TextColor="#4CAF50" FontSize="16" HorizontalOptions="Center" />

        <Border Grid.Row="2" Stroke="#333333" StrokeThickness="1" BackgroundColor="#121212">
            <Editor x:Name="LogEditor" IsReadOnly="True" TextColor="#00FF66"
                    BackgroundColor="Transparent" FontFamily="monospace" FontSize="12"
                    AutoSize="Disabled" />
        </Border>

        <VerticalStackLayout Grid.Row="3" Spacing="8" HorizontalOptions="Fill">
            <Entry x:Name="ServerEntry" Placeholder="Адрес сервера на ПК" Text="http://127.0.0.1:5000"
                   TextColor="White" BackgroundColor="#2A2A2A" FontSize="14" />
            <Button x:Name="CheckButton" Text="1. Проверить сервер" Clicked="OnCheckServerClicked"
                    BackgroundColor="#007ACC" TextColor="White" CornerRadius="8" Padding="15,10" />
            <Button x:Name="PatchButton" Text="2. Установить перевод" Clicked="OnApplyPatchClicked"
                    BackgroundColor="#2EA043" TextColor="White" CornerRadius="8" Padding="15,10" />
            <Button x:Name="PhoneInstallButton" Text="5. Установить перевод на этот телефон" Clicked="OnPhoneInstallClicked"
                    BackgroundColor="#2EA043" TextColor="White" CornerRadius="8" Padding="15,10" />
            <Button x:Name="PhoneRestoreButton" Text="6. Вернуть оригиналы на этом телефоне" Clicked="OnPhoneRestoreClicked"
                    BackgroundColor="#B33A3A" TextColor="White" CornerRadius="8" Padding="15,10" />
            <Button x:Name="PhoneSyncButton" Text="7. Передать главы на ПК" Clicked="OnPhoneSyncClicked"
                    BackgroundColor="#0B7285" TextColor="White" CornerRadius="8" Padding="15,10" />
            <Button x:Name="PhoneCheckButton" Text="8. Проверить обновления" Clicked="OnPhoneCheckClicked"
                    BackgroundColor="#7A5C00" TextColor="White" CornerRadius="8" Padding="15,10" />
            <Button x:Name="ShizukuButton" Text="4. Проверить Shizuku" Clicked="OnCheckShizukuClicked"
                    BackgroundColor="#6A4FB3" TextColor="White" CornerRadius="8" Padding="15,10" />
            <Button x:Name="RestoreButton" Text="3. Вернуть оригиналы" Clicked="OnRestoreClicked"
                    BackgroundColor="#B33A3A" TextColor="White" CornerRadius="8" Padding="15,10" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
